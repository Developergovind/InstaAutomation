# ─────────────────────────────────────────────
# Server / Infra (these stay in .env — everything else moves to dashboard Settings)
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DB_PATH=./data/instagram-automation.sqlite
FRONTEND_URL=http://localhost:3001
# Comma-separated allowed browser origins (production: add your Vercel URL)
# CORS_ORIGINS=https://insta-automation-web.vercel.app,http://localhost:3001
# CORS_ALLOW_VERCEL=true

# ─────────────────────────────────────────────
# Auth — single-operator login for the dashboard
# Change these before deploying anywhere shared!
# ─────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
ADMIN_EMAIL=admin@automation.local
ADMIN_PASSWORD=Admin@12345

# ─────────────────────────────────────────────
# Everything below is OPTIONAL fallback defaults.
# Once saved via dashboard Settings, DB values take over.
# ─────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_MODEL=flux
POLLINATIONS_WIDTH=1080
POLLINATIONS_HEIGHT=1080
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
TRENDS_GEO=IN
NEWS_LANG=en-IN
NEWS_COUNTRY=IN
CONTENT_NICHE=general
CRON_TREND_FETCH=0 */3 * * *
CRON_POST_GENERATION=0 9,18 * * *
CRON_ANALYTICS_FETCH=0 */6 * * *
TIMEZONE=Asia/Kolkata
