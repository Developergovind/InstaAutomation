# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Groq AI (text: trending, captions, image prompts)
# Get from: https://console.groq.com/keys
# Models: https://console.groq.com/docs/models
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────
# Image generation (Groq has no image API — uses Pollinations by default)
# Optional: change base URL if you use another image service
# ─────────────────────────────────────────────
IMAGE_API_URL=https://image.pollinations.ai/prompt

# ─────────────────────────────────────────────
# Instagram / Meta Graph API
# Steps:
# 1. Create app at https://developers.facebook.com
# 2. Add Instagram Graph API product
# 3. Connect your Instagram Business/Creator account
# 4. Generate access token from Graph API Explorer (short-lived is OK — app auto-converts)
# 5. Set META_APP_ID + META_APP_SECRET for automatic long-lived page token
#    Page tokens do NOT expire — no manual token updates needed after first startup
# ─────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_initial_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─────────────────────────────────────────────
# ImgBB (Free image hosting — required for Meta API)
# Get free API key from: https://imgbb.com/login -> API
# ─────────────────────────────────────────────
IMGBB_API_KEY=your_imgbb_api_key_here

# ─────────────────────────────────────────────
# Scheduler
# Cron format: minute hour day month weekday
# Examples:
#   '0 9 * * *'   → every day at 9:00 AM
#   '0 9,18 * * *' → 9 AM and 6 PM daily
#   '0 9 * * 1-5' → weekdays at 9 AM
# ─────────────────────────────────────────────
POST_CRON_TIME=0 9 * * *
TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────
# Content
# The niche/topic area for trending topics
# Examples: technology, fashion, fitness, food, travel, crypto
# ─────────────────────────────────────────────
CONTENT_NICHE=technology
