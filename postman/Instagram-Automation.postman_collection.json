{
  "info": {
    "name": "Instagram Automation v2.1 (Groq + Pollinations)",
    "description": "NestJS Instagram automation — Google Trends/News RSS + Groq text + Pollinations images + Meta Graph API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" }
  ],
  "item": [
    {
      "name": "Trends",
      "item": [
        {
          "name": "Fetch Trends (Manual)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/trends/fetch"
          }
        },
        {
          "name": "List Ranked Trends",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trends?limit=50"
          }
        },
        {
          "name": "Get Top Unprocessed Trend",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trends/top"
          }
        },
        {
          "name": "Get Trend by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trends/{{trendId}}"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Publish Top Trend",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/instagram/post"
          }
        },
        {
          "name": "Publish Specific Trend",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trendId\": \"{{trendId}}\"\n}"
            },
            "url": "{{baseUrl}}/instagram/post"
          }
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts?page=1&limit=20"
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Instagram",
      "item": [
        {
          "name": "Check Container Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instagram/status/{{containerId}}"
          }
        }
      ]
    }
  ]
}
